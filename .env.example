# 监听地址
HPM_BIND=0.0.0.0:8080
# 数据存储目录
HPM_DATA_DIR=data
# 认证模式：local / oidc / hybrid（本版本仅实现 local）
HPM_AUTH_MODE=local

# 首次启动时创建的管理员账户（local 模式下必填）
HPM_BOOTSTRAP_ADMIN_USERNAME=admin
HPM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# 可选：固定保险库密钥。设置后凭据以此确定性派生；
# 若不设置，将在 data/vault.key 生成随机密钥（权限 0600）。
# 备份时务必与数据库一同保管。
# HPM_VAULT_SECRET=replace-with-a-long-random-vault-secret

# 可选：自签名/私有 CA 证书场景下跳过 TLS 校验（仅内部自用）
# HPM_INSECURE_TLS=1
