# HousePlusMail 后端环境变量示例
#
# 用途：
#   1) 本地/Docker：复制为 server/.env 后由 start.sh 读取
#   2) Railway / Cloudflare Containers：在容器或平台配置的「Environment variables」里逐项填入
#
# 部署前请一定把 HPM_BOOTSTRAP_ADMIN_PASSWORD 改成强密码。

# 监听地址:端口（Dockerfile 已默认 0.0.0.0:8080）
HPM_BIND=0.0.0.0:8080

# 数据目录（Dockerfile 已默认 /app/data；本地可改 ./data）
HPM_DATA_DIR=/app/data

# 认证模式（本版仅实现 local）
HPM_AUTH_MODE=local

# 首次启动创建的管理员（部署前务必改成强密码！）
HPM_BOOTSTRAP_ADMIN_USERNAME=admin
HPM_BOOTSTRAP_ADMIN_PASSWORD=ReplaceThisWithAStrongPassword123

# 拆分部署：允许的前端来源（必须等于前端的完整 URL，含 https://）
# 示例：Cloudflare Pages 前端 = https://hpmail.ccwu.cc（本项目实际域名）
HPM_CORS_ORIGIN=https://hpmail.ccwu.cc

# 可选：固定保险库密钥（备份时需与 HPM_DATA_DIR 一起保管）
# HPM_VAULT_SECRET=一个足够长的随机字符串

# 可选：私有 CA / 自签名证书场景跳过 TLS 校验
# HPM_INSECURE_TLS=1
# 开放自助注册：默认开启（true）。设为 false 关闭开放注册（此时仅已有账户可登录）。
HPM_REGISTRATION_ENABLED=true
